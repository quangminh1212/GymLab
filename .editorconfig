root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.md]
max_line_length = 0
trim_trailing_whitespace = false

[*.{html,css,js,json,yaml,yml}]
indent_size = 2

[*.{rs,toml}]
indent_size = 4

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
